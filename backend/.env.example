# ==============================================
# .env.example — 이 파일을 복사해서 .env 로 이름 바꾼 뒤
# 실제 값을 채워넣으세요.
# .env 파일은 절대 Github에 올리지 마세요!
# ==============================================

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=여기에_MySQL_비밀번호_입력
DB_NAME=crocini_db
PORT=3000

# 토스페이먼츠 시크릿 키
# - 개발: 비워두면 토스 공식 테스트 키로 동작 (NODE_ENV != production)
# - 운영(Railway 등): NODE_ENV=production이면 반드시 설정 필요. 미설정 시 서버가 시작되지 않음.
TOSS_SECRET_KEY=
